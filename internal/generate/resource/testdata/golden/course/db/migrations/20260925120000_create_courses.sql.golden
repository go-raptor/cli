-- +goose Up
CREATE TABLE courses (
    id             BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    user_id        BIGINT NOT NULL,
    name           VARCHAR(150) NOT NULL,
    lecture_hours  INTEGER NOT NULL DEFAULT 0,
    division_id    BIGINT NOT NULL,
    created_at     TIMESTAMPTZ NOT NULL DEFAULT current_timestamp,
    updated_at     TIMESTAMPTZ NOT NULL DEFAULT current_timestamp,
    CONSTRAINT courses_user_id_fkey FOREIGN KEY (user_id)
        REFERENCES users (id) ON DELETE CASCADE,
    CONSTRAINT courses_division_id_fkey FOREIGN KEY (division_id)
        REFERENCES divisions (id) ON DELETE RESTRICT,
    CONSTRAINT courses_lecture_hours_check CHECK (lecture_hours >= 0)
);

CREATE INDEX courses_user_id_idx ON courses (user_id);
CREATE INDEX courses_division_id_idx ON courses (division_id);

CREATE TRIGGER courses_set_updated_at
    BEFORE UPDATE ON courses
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

-- +goose Down
DROP TABLE IF EXISTS courses;
