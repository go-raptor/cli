package services

import (
	"example.com/shop/app/models"
	"github.com/Oudwins/zog"
	"github.com/go-raptor/raptor/v4"
)

// ValidationService builds every schema once, at startup, and shares it with every request.
type ValidationService struct {
	raptor.Service

	CourseSchema  *zog.StructSchema
	OutcomeSchema *zog.StructSchema
	UnitSchema    *zog.StructSchema
	RecordSchema  *zog.StructSchema
}

func (s *ValidationService) Setup() error {
	s.CourseSchema = models.CourseSchema()
	s.OutcomeSchema = models.OutcomeSchema()
	s.UnitSchema = models.UnitSchema()
	s.RecordSchema = models.RecordSchema()
	return nil
}
