routes:
  /api/v1:
    /auth:
      /login:
        POST: Auth.Login
    /courses:
      GET: Courses.Index
      POST: Courses.Create
      /{id}:
        GET: Courses.Show
        PUT: Courses.Update
        DELETE: Courses.Destroy
    /outcomes:
      GET: Outcomes.Index
      POST: Outcomes.Create
      /{id}:
        GET: Outcomes.Show
        PUT: Outcomes.Update
        DELETE: Outcomes.Destroy
    /units:
      GET: Units.Index
      POST: Units.Create
      /{id}:
        GET: Units.Show
        PUT: Units.Update
        DELETE: Units.Destroy
