package controllers_test

import (
	"bytes"
	"encoding/json/v2"
	"fmt"
	"io"
	"net/http"
	"net/http/httptest"
	"slices"
	"testing"
	"time"

	"example.com/shop/app/models"
	"github.com/go-raptor/raptor/v4"
)

// outcomesRequest sends body as JSON, with the session cookie when there is one.
func outcomesRequest(t *testing.T, method, path string, session *http.Cookie, body any) *httptest.ResponseRecorder {
	t.Helper()
	var reader io.Reader
	if body != nil {
		encoded, err := json.Marshal(body)
		if err != nil {
			t.Fatal(err)
		}
		reader = bytes.NewReader(encoded)
	}
	var opts []raptor.TestRequestOption
	if session != nil {
		opts = append(opts, withSession(session))
	}
	return app.TestRequest(method, path, reader, opts...)
}

// validOutcomeRequest is a request that passes validation, under a course owned by userID.
func validOutcomeRequest(t *testing.T, userID int64) models.OutcomeRequest {
	t.Helper()
	return models.OutcomeRequest{
		CourseID: seedCourse(t, userID).ID,
		Name:     "Sample",
		Criteria: "Sample text",
		Position: 1,
	}
}

func TestOutcomesRequireAuth(t *testing.T) {
	if rec := outcomesRequest(t, http.MethodGet, "/api/v1/outcomes", nil, nil); rec.Code != http.StatusUnauthorized {
		t.Fatalf("GET without a session: %d, want 401", rec.Code)
	}
}

func TestOutcomesOwnerLifecycle(t *testing.T) {
	owner := newUser(t, fmt.Sprintf("owner-%d", time.Now().UnixNano()))
	session := login(t, owner.Username)
	req := validOutcomeRequest(t, owner.ID)

	rec := outcomesRequest(t, http.MethodPost, "/api/v1/outcomes", session, req)
	if rec.Code != http.StatusCreated {
		t.Fatalf("create: %d %s", rec.Code, rec.Body)
	}
	var created models.OutcomeResponse
	if err := json.Unmarshal(rec.Body.Bytes(), &created); err != nil {
		t.Fatal(err)
	}
	if created.ID == 0 || created.CreatedAt.IsZero() {
		t.Fatalf("create must return the stored row: %+v", created)
	}
	path := fmt.Sprintf("/api/v1/outcomes/%d", created.ID)

	if rec := outcomesRequest(t, http.MethodGet, path, session, nil); rec.Code != http.StatusOK {
		t.Fatalf("show: %d %s", rec.Code, rec.Body)
	}

	req.Name = "Updated"
	rec = outcomesRequest(t, http.MethodPut, path, session, req)
	if rec.Code != http.StatusOK {
		t.Fatalf("update: %d %s", rec.Code, rec.Body)
	}
	var updated models.OutcomeResponse
	if err := json.Unmarshal(rec.Body.Bytes(), &updated); err != nil {
		t.Fatal(err)
	}
	if updated.Name != "Updated" {
		t.Fatalf("the update did not persist: %+v", updated)
	}

	rec = outcomesRequest(t, http.MethodGet, "/api/v1/outcomes", session, nil)
	if rec.Code != http.StatusOK {
		t.Fatalf("list: %d %s", rec.Code, rec.Body)
	}
	var listed models.OutcomeResponses
	if err := json.Unmarshal(rec.Body.Bytes(), &listed); err != nil {
		t.Fatal(err)
	}
	if !slices.ContainsFunc(listed, func(x models.OutcomeResponse) bool { return x.ID == created.ID }) {
		t.Fatalf("the list does not include the new outcome: %+v", listed)
	}

	if rec := outcomesRequest(t, http.MethodDelete, path, session, nil); rec.Code != http.StatusNoContent {
		t.Fatalf("delete: %d %s", rec.Code, rec.Body)
	}
	if rec := outcomesRequest(t, http.MethodGet, path, session, nil); rec.Code != http.StatusNotFound {
		t.Fatalf("show after delete: %d, want 404", rec.Code)
	}
}

func TestOutcomesStrangerGets404(t *testing.T) {
	suffix := time.Now().UnixNano()
	owner := newUser(t, fmt.Sprintf("owner-%d", suffix))
	stranger := newUser(t, fmt.Sprintf("stranger-%d", suffix))
	strangerSession := login(t, stranger.Username)
	outcome := seedOutcome(t, owner.ID)
	path := fmt.Sprintf("/api/v1/outcomes/%d", outcome.ID)

	if rec := outcomesRequest(t, http.MethodGet, path, strangerSession, nil); rec.Code != http.StatusNotFound {
		t.Errorf("stranger show: %d, want 404", rec.Code)
	}
	if rec := outcomesRequest(t, http.MethodPut, path, strangerSession, validOutcomeRequest(t, stranger.ID)); rec.Code != http.StatusNotFound {
		t.Errorf("stranger update: %d, want 404", rec.Code)
	}
	if rec := outcomesRequest(t, http.MethodDelete, path, strangerSession, nil); rec.Code != http.StatusNotFound {
		t.Errorf("stranger delete: %d, want 404", rec.Code)
	}
	if rec := outcomesRequest(t, http.MethodGet, path, login(t, owner.Username), nil); rec.Code != http.StatusOK {
		t.Errorf("the owner's outcome must survive the stranger: %d", rec.Code)
	}
}

func TestOutcomesCreateValidation(t *testing.T) {
	owner := newUser(t, fmt.Sprintf("owner-%d", time.Now().UnixNano()))
	rec := outcomesRequest(t, http.MethodPost, "/api/v1/outcomes", login(t, owner.Username), map[string]any{})
	if rec.Code != http.StatusUnprocessableEntity {
		t.Fatalf("empty body: %d, want 422; %s", rec.Code, rec.Body)
	}
}

func TestOutcomesUnderStrangersCourse(t *testing.T) {
	suffix := time.Now().UnixNano()
	owner := newUser(t, fmt.Sprintf("owner-%d", suffix))
	stranger := newUser(t, fmt.Sprintf("stranger-%d", suffix))
	session := login(t, owner.Username)
	strangersCourse := seedCourse(t, stranger.ID)

	req := validOutcomeRequest(t, owner.ID)
	req.CourseID = strangersCourse.ID
	if rec := outcomesRequest(t, http.MethodPost, "/api/v1/outcomes", session, req); rec.Code != http.StatusNotFound {
		t.Errorf("create under the stranger's course: %d, want 404", rec.Code)
	}
	list := fmt.Sprintf("/api/v1/outcomes?courseId=%d", strangersCourse.ID)
	if rec := outcomesRequest(t, http.MethodGet, list, session, nil); rec.Code != http.StatusNotFound {
		t.Errorf("list under the stranger's course: %d, want 404", rec.Code)
	}
}
