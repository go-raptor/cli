-- +goose Up
CREATE TABLE outcomes (
    id          BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    course_id   BIGINT NOT NULL,
    name        VARCHAR(150) NOT NULL,
    criteria    TEXT NOT NULL DEFAULT '',
    position    INTEGER NOT NULL DEFAULT 0,
    created_at  TIMESTAMPTZ NOT NULL DEFAULT current_timestamp,
    updated_at  TIMESTAMPTZ NOT NULL DEFAULT current_timestamp,
    CONSTRAINT outcomes_course_id_fkey FOREIGN KEY (course_id)
        REFERENCES courses (id) ON DELETE CASCADE,
    CONSTRAINT outcomes_position_check CHECK (position >= 0)
);

CREATE INDEX outcomes_course_id_idx ON outcomes (course_id);

CREATE TRIGGER outcomes_set_updated_at
    BEFORE UPDATE ON outcomes
    FOR EACH ROW EXECUTE FUNCTION set_updated_at();

-- +goose Down
DROP TABLE IF EXISTS outcomes;
