package controllers_test

import (
	"os"
	"testing"

	"github.com/go-raptor/raptor/v4"
	"{{.Module}}/config"
	"{{.Module}}/config/components"
)

var app *raptor.Raptor

func TestMain(m *testing.M) {
	// NewTestApp loads .raptor.test.yaml, where an app serving its frontend sets
	// app.spa_optional: tests have no frontend build.
	app = raptor.NewTestApp(components.New(), config.Routes())
	os.Exit(m.Run())
}
