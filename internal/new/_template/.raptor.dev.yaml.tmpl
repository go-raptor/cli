general:
  log_level: debug

server:
  address: localhost
  port: 3000
  shutdown_timeout: 3
  read_timeout: 0
  read_header_timeout: 10
  write_timeout: 0
  idle_timeout: 120
  max_header_bytes: 1048576
  # max_body_bytes defaults to 8388608 (8 MB). Raise it only for uploads,
  # and still check each file's size in the upload endpoint.
  ip_extractor: direct
{{- if .SPA}}

app:
  # Boot without a frontend build in public/. This file is for development only: production is
  # configured with .raptor.prod.yaml or environment variables, which leave this unset.
  spa_optional: "true"
{{- end}}
