routes:
  # Liveness and readiness probes, answered by Raptor's built-in HealthController.
  /healthz:
    GET: Health.Live
  /readyz:
    GET: Health.Ready
  /api/v1:
    /hello:
      GET: Hello.Greet
      POST: Hello.AddGreetings
{{- if .SPA}}
    /{path...}: Errors.NotFound
  /: SPA.Index
{{- end}}
